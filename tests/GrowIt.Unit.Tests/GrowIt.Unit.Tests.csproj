<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- No unit tests yet; Microsoft.Testing.Platform fails a run with zero tests (exit code 8).
         Remove this with the first test, or a run that discovers nothing will still pass. -->
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GrowIt.Application\GrowIt.Application.csproj" />
    <ProjectReference Include="..\..\src\GrowIt.Domain\GrowIt.Domain.csproj" />
  </ItemGroup>

</Project>
